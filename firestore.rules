rules_version = '2';

// Regras de segurança do Firestore — Gestão de Loja
//
// Estrutura:
//   acessos/{uid}                     → { lojaId, perfil: 'dono' | 'vendedor', nome, email, ativo }
//   lojas/{lojaId}                    → { nome, donoUid, criadoEm, bloqueada, motivoBloqueio }
//   lojas/{lojaId}/ajustes/{nome}     → loja, fiscal, config, cores, tamanhos, categorias
//   lojas/{lojaId}/{colecao}/{id}     → produtos, vendas, clientes, caixas…
//   assinaturas/{lojaId}              → mensalidade da loja (só o suporte altera)
//   assinaturas/{lojaId}/pagamentos/{AAAA-MM}
//
// Quem não está logado não lê nem grava nada.
// Cada usuário só enxerga a loja dele. Alguns dados só o dono altera.
// O suporte (super admin) administra todas as lojas e as mensalidades.
// Loja bloqueada pelo suporte não lê nem grava os próprios dados.
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠ Mesma lista de window.SUPER_ADMIN_UIDS em js/firebase-config.js
    function superAdmin() {
      return request.auth != null && request.auth.uid in [
        'WLmBJby1xoRFC95wPOcKdoad0uo1'
      ];
    }

    function acesso() {
      return get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data;
    }
    function temAcesso() {
      return request.auth != null
        && exists(/databases/$(database)/documents/acessos/$(request.auth.uid))
        && acesso().ativo != false;
    }
    function membro(lojaId) { return temAcesso() && acesso().lojaId == lojaId; }
    function bloqueada(lojaId) {
      let loja = /databases/$(database)/documents/lojas/$(lojaId);
      return exists(loja) && get(loja).data.get('bloqueada', false) == true;
    }
    function ativo(lojaId) { return membro(lojaId) && !bloqueada(lojaId); }
    function dono(lojaId) { return ativo(lojaId) && acesso().perfil == 'dono'; }

    // Vínculo usuário → loja
    match /acessos/{uid} {
      allow read: if superAdmin() || (request.auth != null
        && (request.auth.uid == uid || dono(resource.data.lojaId)));
      // Lojas novas só pelo suporte (painel). O dono cadastra usuários da própria loja.
      allow create: if superAdmin() || dono(request.resource.data.lojaId);
      // Só o dono altera ou remove acessos da própria loja (e não muda a loja de ninguém)
      allow update: if superAdmin() || (dono(resource.data.lojaId)
        && request.resource.data.lojaId == resource.data.lojaId);
      allow delete: if superAdmin() || dono(resource.data.lojaId);
    }

    match /lojas/{lojaId} {
      // O membro lê o cabeçalho mesmo bloqueado (para ver o aviso de bloqueio)
      allow read: if superAdmin() || membro(lojaId);
      allow create: if superAdmin();
      // O dono não pode mexer no bloqueio
      allow update: if superAdmin() || (dono(lojaId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bloqueada', 'motivoBloqueio']));
      allow delete: if false;

      // Pedidos online: a cliente do catálogo (sem login) só pode CRIAR um pedido novo,
      // com campos conferidos. Ler e mudar o pedido é só para quem trabalha na loja.
      match /pedidos/{pedidoId} {
        allow create: if request.resource.data.keys().hasOnly(['id', 'codigo', 'status', 'origem', 'criadoEm', 'cliente', 'entrega', 'endereco', 'obs', 'itens', 'total', 'subtotal', 'cupom'])
          && request.resource.data.status == 'novo'
          && request.resource.data.origem == 'catalogo'
          && request.resource.data.id == pedidoId
          && request.resource.data.itens is list
          && request.resource.data.itens.size() > 0 && request.resource.data.itens.size() <= 40
          && request.resource.data.total is number
          && request.resource.data.total >= 0 && request.resource.data.total <= 1000000
          // Tamanho dos campos (o pedido vem de qualquer pessoa, sem login)
          && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 12
          && request.resource.data.criadoEm is string && request.resource.data.criadoEm.size() <= 40
          && request.resource.data.entrega in ['retirar', 'entregar']
          && request.resource.data.cliente is map
          && request.resource.data.cliente.keys().hasOnly(['nome', 'telefone'])
          && request.resource.data.cliente.nome is string && request.resource.data.cliente.nome.size() <= 60
          && request.resource.data.cliente.get('telefone', '') is string && request.resource.data.cliente.get('telefone', '').size() <= 20
          && request.resource.data.get('endereco', '') is string && request.resource.data.get('endereco', '').size() <= 200
          && request.resource.data.get('obs', '') is string && request.resource.data.get('obs', '').size() <= 220
          && (!('subtotal' in request.resource.data) || (request.resource.data.subtotal is number && request.resource.data.subtotal >= 0))
          && (!('cupom' in request.resource.data) || (request.resource.data.cupom is map
            && request.resource.data.cupom.keys().hasOnly(['codigo', 'desconto'])
            && request.resource.data.cupom.codigo is string && request.resource.data.cupom.codigo.size() <= 20
            && request.resource.data.cupom.desconto is number && request.resource.data.cupom.desconto >= 0))
          && exists(/databases/$(database)/documents/catalogos/$(lojaId))
          && get(/databases/$(database)/documents/catalogos/$(lojaId)).data.publicado == true;
      }

      // Dados da loja: todos os membros leem (loja ativa).
      // O vendedor grava o que o dia a dia exige (vendas, caixa, estoque, clientes…);
      // o resto (configurações, usuários, fornecedores, contas a pagar, promoções) é só do dono.
      match /{colecao}/{docId} {
        allow read: if superAdmin() || ativo(lojaId);
        allow write: if superAdmin() || dono(lojaId) || (ativo(lojaId) && colecao in [
          'vendas', 'produtos', 'movimentacoes', 'caixas', 'creditos',
          'clientes', 'contasReceber', 'notas', 'inventarios', 'pedidos'
        ]);
      }
    }

    // Mensalidades: só o suporte altera; o dono pode consultar a da própria loja
    match /assinaturas/{lojaId} {
      allow read: if superAdmin() || membro(lojaId);
      allow write: if superAdmin();
      match /pagamentos/{competencia} {
        allow read: if superAdmin() || membro(lojaId);
        allow write: if superAdmin();
      }
      // "Já paguei": o dono avisa (mesmo com a loja bloqueada); só o suporte confirma ou recusa
      match /avisos/{competencia} {
        allow read: if superAdmin() || membro(lojaId);
        allow create, update: if superAdmin() || (membro(lojaId) && acesso().perfil == 'dono'
          && request.resource.data.status == 'pendente'
          && (resource == null || resource.data.status != 'confirmado'));
        allow delete: if superAdmin();
      }
    }

    // Catálogo online: cópia PÚBLICA só com nome, foto, preço e tamanhos com estoque.
    // Qualquer pessoa lê (é a vitrine); só quem trabalha na loja atualiza.
    match /catalogos/{lojaId} {
      allow read: if true;
      allow write: if superAdmin() || ativo(lojaId);
    }
  }
}
